# Local image from an already published build (no SDK image needed):
#   dotnet publish src/Gebeta.Api -c Release -o artifacts/publish
#   docker build -f deploy/Dockerfile.local -t abay/gebeta-server:dev .
# Same runtime stage as deploy/Dockerfile.

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY artifacts/publish/ ./
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_gcServer=0 \
    TZ=Africa/Addis_Ababa
EXPOSE 8080
USER app
HEALTHCHECK --interval=15s --timeout=5s --retries=10 \
  CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080 && printf "GET /health/live HTTP/1.0\r\n\r\n" >&3 && grep -q "200 OK" <&3' || exit 1
ENTRYPOINT ["dotnet", "Gebeta.Api.dll"]

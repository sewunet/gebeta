root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx}]
indent_size = 2

# EF Core migrations are generated by "dotnet ef"; do not apply code-style analyzers to them.
[**/Migrations/*.cs]
generated_code = true

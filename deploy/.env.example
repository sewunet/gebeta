# Copy to deploy/.env and fill in. deploy/.env is never committed.

GEBETA_VERSION=dev

POSTGRES_DB=gebeta
POSTGRES_USER=gebeta
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

RABBITMQ_USER=gebeta
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=gebeta
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_METRICS_PORT=15692

REDIS_PORT=6379

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8180
# Address users' browsers use to reach Keycloak; it appears as the issuer in tokens.
KEYCLOAK_PUBLIC_URL=http://localhost:8180

SEQ_PORT=5341
WEB_PORT=8080
SERVER_PORT=5090

# Username that becomes System Manager on first sign-in (new installations).
GEBETA_BOOTSTRAP_ADMIN=

# Local development sign-in (Keycloak realm gebeta). Development only.
GEBETA_DEV_USER=gebeta.admin
GEBETA_DEV_PASSWORD=

<Project>
  <!-- Settings shared by every project in Gebeta (see docs/conventions.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CA1716: names like Error clash only with Visual Basic keywords; Gebeta is C# only. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
    <Company>Abay Systems</Company>
    <Product>Gebeta ERP</Product>
    <Authors>Abay Systems</Authors>
  </PropertyGroup>
</Project>
